# ============================================================
# Configuration de l'application BankApp
# Copiez ce fichier en .env et adaptez les valeurs.
# ============================================================

# ── Application ─────────────────────────────────────────────
# URL publique de l'application (sans slash final)
APP_URL=http://localhost:8080

# Affiche les erreurs détaillées en cas d'exception (true/false)
APP_DEBUG=true

# Clé secrète utilisée pour signer les JWT.
# Générez-en une avec : openssl rand -hex 32
APP_KEY=changez_cette_cle_en_production_avec_une_chaine_aleatoire

# ── Base de données ─────────────────────────────────────────
DB_HOST=db
DB_PORT=3306
DB_DATABASE=bankapp
DB_USERNAME=bankapp
DB_PASSWORD=bankapp_secret

# Mot de passe root MariaDB (utilisé uniquement par Docker Compose)
MYSQL_ROOT_PASSWORD=rootsecret

# ── Email (SMTP) ─────────────────────────────────────────────
# En développement, pointez vers Mailpit (service Docker inclus).
# Interface web Mailpit : http://localhost:8025
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=noreply@bankapp.local
MAIL_FROM_NAME=BankApp

# Chiffrement SMTP : laisser vide (Mailpit), ou "tls" / "ssl" en production
MAIL_ENCRYPTION=

# Identifiants SMTP (laisser vide pour Mailpit)
MAIL_USERNAME=
MAIL_PASSWORD=

