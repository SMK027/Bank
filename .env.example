# ============================================================
# Configuration de l'application BankApp
# Copiez ce fichier en .env et adaptez les valeurs.
# ============================================================

# ── Application ─────────────────────────────────────────────
# Domaine public (utilisé par Traefik pour le routage et les certificats)
APP_DOMAIN=bankapp.example.com

# URL publique complète (déduite de APP_DOMAIN en production)
APP_URL=https://bankapp.example.com

# Affiche les erreurs détaillées en cas d'exception (true/false)
APP_DEBUG=false

# Clé secrète utilisée pour signer les JWT.
# Générez-en une avec : openssl rand -hex 32
APP_KEY=changez_cette_cle_en_production_avec_une_chaine_aleatoire

# ── Base de données (mutualisée en production) ──────────────
# Accessible via le réseau externe Docker "db_internal"
DB_HOST=nom-du-serveur-db
DB_PORT=3306
DB_DATABASE=bankapp
DB_USERNAME=bankapp
DB_PASSWORD=bankapp_secret

# ── Email (SMTP) ─────────────────────────────────────────────
# En production, pointez vers votre fournisseur SMTP réel.
# En développement, mailpit est fourni par docker-compose.dev.yml.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_FROM=noreply@bankapp.example.com
MAIL_FROM_NAME=BankApp

# Chiffrement SMTP : "tls" (STARTTLS/587), "ssl" (SMTPS/465), ou vide
MAIL_ENCRYPTION=tls

# Identifiants SMTP
MAIL_USERNAME=
MAIL_PASSWORD=


